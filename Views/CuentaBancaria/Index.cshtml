@model IEnumerable<HermesBanking.Domain.Entidades.CuentaBancaria>

<h2>Cuentas Bancarias</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Crear nueva cuenta</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Número</th>
            <th>Tipo</th>
            <th>Saldo</th>
            <th>Usuario ID</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cuenta in Model)
        {
            <tr>
                <td>@cuenta.NumeroCuenta</td>
                <td>@cuenta.TipoCuenta</td>
                <td>@cuenta.Saldo</td>
                <td>@cuenta.UsuarioId</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@cuenta.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@cuenta.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

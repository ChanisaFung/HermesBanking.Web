@model HermesBanking.Domain.Entidades.CuentaBancaria

<h2>Eliminar Cuenta Bancaria</h2>

<h4>¿Estás seguro de que deseas eliminar esta cuenta?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-2">Número</dt>
    <dd class="col-sm-10">@Model.NumeroCuenta</dd>

    <dt class="col-sm-2">Tipo</dt>
    <dd class="col-sm-10">@Model.TipoCuenta</dd>

    <dt class="col-sm-2">Saldo</dt>
    <dd class="col-sm-10">@Model.Saldo</dd>

    <dt class="col-sm-2">Usuario ID</dt>
    <dd class="col-sm-10">@Model.UsuarioId</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>


@model HermesBanking.Domain.Entidades.CuentaBancaria

<h2>Crear Cuenta</h2>

<form asp-action="Create">
    <div class="mb-3">
        <label>Número de Cuenta</label>
        <input asp-for="NumeroCuenta" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Tipo de Cuenta</label>
        <input asp-for="TipoCuenta" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Saldo</label>
        <input asp-for="Saldo" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Usuario</label>
        <select asp-for="UsuarioId" asp-items="@(ViewData["Usuarios"] as List<SelectListItem>)" class="form-control">
            <option value="">-- Selecciona un usuario --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
